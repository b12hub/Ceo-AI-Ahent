# ============================================================
# CEO_AI_test_bot — Environment Variable Template
# Copy this file to .env and fill in all values.
# NEVER commit the real .env file to Git.
# ============================================================

# --- Application ---
PROJECT_NAME=CEO AI AGENT
WEBHOOK_URL=https://YOUR_DOMAIN_OR_VPS_IP/webhook
WEBHOOK_SECRET=change-me-to-a-strong-random-secret
DASHBOARD_BASE_URL=https://YOUR_DOMAIN_OR_VPS_IP

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg2://ceo_admin:securepassword123@postgres:5432/ceo_agent_db

# --- Telegram ---
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CE0_ID=YOUR_TELEGRAM_USER_ID
TELEGRAM_CEO_ID=YOUR_TELEGRAM_USER_ID
ALLOWED_USERS=YOUR_TELEGRAM_USER_ID

# --- Internal API (for n8n endpoints) ---
INTERNAL_API_KEY=change-me-to-another-strong-secret

# --- AI APIs ---
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=your_google_genai_key_here
GOOGLE_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# --- Google Sheets (optional) ---
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_NAME=Your Sheet Name
GOOGLE_SHEET_ID=your_sheet_id_here

# --- Zoom API (optional) ---
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
